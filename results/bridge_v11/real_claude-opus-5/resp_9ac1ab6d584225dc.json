{"text": "{\"lexicon_nouns\": [{\"kind\": \"count\", \"noun\": \"pages\"}, {\"kind\": \"length\", \"noun\": \"inch\"}], \"adj_maps\": [{\"adj\": \"thick\", \"kind\": \"length\"}, {\"adj\": \"stacked\", \"kind\": \"length\"}], \"unit_index\": [{\"unit\": \"inch\", \"kind\": \"length\"}, {\"unit\": \"inches\", \"kind\": \"length\"}], \"conversions\": [{\"concept\": \"length\", \"units\": [\"inch\", \"inches\"], \"op\": \"mul\", \"factor\": 0.0254}], \"new_kinds\": [{\"name\": \"sheet_density\", \"dim\": [0, -1, 0, 0, 0, 0, 0], \"unit\": \"1/m\", \"nouns\": [\"pages\"], \"aliases\": [\"pages/inch\"]}], \"new_caps\": [{\"name\": \"pages_from_thickness\", \"inputs\": [\"sheet_density\", \"length\"], \"output\": \"count\", \"expr\": \"sheet_density * length * 2\"}]}", "tokens_in": 813, "tokens_out": 162}