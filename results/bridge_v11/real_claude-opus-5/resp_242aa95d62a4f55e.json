{"text": "{\"lexicon_nouns\": [{\"kind\": \"cost_total\", \"noun\": \"cost\"}, {\"kind\": \"count\", \"noun\": \"week\"}], \"adj_maps\": [{\"adj\": \"spend\", \"kind\": \"cost_total\"}], \"unit_index\": [{\"unit\": \"%\", \"kind\": \"rate_tax\"}], \"conversions\": [{\"concept\": \"rate_tax\", \"units\": [\"%\"], \"op\": \"div\", \"factor\": 100}], \"new_kinds\": [{\"name\": \"weekly_spend\", \"dim\": [0, 0, -1, 0, 0, 0, 1], \"unit\": \"$/wk\", \"nouns\": [\"dollars\"], \"aliases\": [\"$ per week\"]}], \"new_caps\": [{\"name\": \"weekly_spend\", \"inputs\": [\"cost_total\", \"rate_tax\", \"count\"], \"output\": \"weekly_spend\", \"expr\": \"cost_total * (1 - rate_tax) / count\"}]}", "tokens_in": 819, "tokens_out": 146}