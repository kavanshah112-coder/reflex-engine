{"text": "{\"lexicon_nouns\": [{\"kind\": \"count\", \"noun\": \"burritos\"}], \"adj_maps\": [{\"adj\": \"leftover\", \"kind\": \"count\"}], \"unit_index\": [], \"conversions\": [], \"new_kinds\": [{\"name\": \"students_count\", \"dim\": [0, 0, 0, 0, 0, 1, 0], \"unit\": \"(count)\", \"nouns\": [\"students\"], \"aliases\": [\"student\"]}, {\"name\": \"per_student_count\", \"dim\": [0, 0, 0, 0, 0, 1, 0], \"unit\": \"(count)\", \"nouns\": [\"each\"], \"aliases\": []}, {\"name\": \"eaten_count\", \"dim\": [0, 0, 0, 0, 0, 1, 0], \"unit\": \"(count)\", \"nouns\": [\"eating\"], \"aliases\": []}, {\"name\": \"leftover_count\", \"dim\": [0, 0, 0, 0, 0, 1, 0], \"unit\": \"(count)\", \"nouns\": [\"leftover\"], \"aliases\": []}], \"new_caps\": [{\"name\": \"leftover_burritos\", \"inputs\": [\"count\", \"students_count\", \"per_student_count\", \"eaten_count\"], \"output\": \"leftover_count\", \"expr\": \"count - students_count * per_student_count - eaten_count\"}]}", "tokens_in": 1060, "tokens_out": 320}
