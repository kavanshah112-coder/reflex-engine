{"text": "{\"lexicon_nouns\": [{\"kind\": \"distance\", \"noun\": \"miles\"}, {\"kind\": \"speed\", \"noun\": \"mph\"}], \"adj_maps\": [], \"unit_index\": [{\"unit\": \"miles\", \"kind\": \"distance\"}, {\"unit\": \"mph\", \"kind\": \"speed\"}, {\"unit\": \"hours\", \"kind\": \"time\"}], \"conversions\": [{\"concept\": \"distance\", \"units\": [\"miles\"], \"op\": \"mul\", \"factor\": 1609.344}, {\"concept\": \"speed\", \"units\": [\"mph\"], \"op\": \"mul\", \"factor\": 0.44704}, {\"concept\": \"time\", \"units\": [\"hours\"], \"op\": \"mul\", \"factor\": 3600}], \"new_kinds\": [], \"new_caps\": [{\"name\": \"round_trip_time\", \"inputs\": [\"distance\", \"speed\", \"time\"], \"output\": \"time\", \"expr\": \"2 * distance / speed + time\"}]}", "tokens_in": 802, "tokens_out": 157}