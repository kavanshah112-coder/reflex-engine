{"text": "{\"lexicon_nouns\": [{\"kind\": \"count\", \"noun\": \"pencils\"}, {\"kind\": \"count\", \"noun\": \"boxes\"}], \"adj_maps\": [{\"adj\": \"loose\", \"kind\": \"count\"}, {\"adj\": \"total\", \"kind\": \"count\"}], \"unit_index\": [], \"conversions\": [], \"new_kinds\": [{\"name\": \"loose_count\", \"dim\": [0, 0, 0, 0, 0, 1, 0], \"unit\": \"units\", \"nouns\": [\"loose\"], \"aliases\": [\"pencils\"]}, {\"name\": \"box_capacity\", \"dim\": [0, 0, 0, 0, 0, 1, 0], \"unit\": \"units\", \"nouns\": [\"boxes\"], \"aliases\": [\"pencils\"]}, {\"name\": \"boxes_needed\", \"dim\": [0, 0, 0, 0, 0, 1, 0], \"unit\": \"units\", \"nouns\": [\"boxes\"], \"aliases\": [\"boxes\"]}], \"new_caps\": [{\"name\": \"box_capacity\", \"inputs\": [\"count\", \"loose_count\"], \"output\": \"box_capacity\", \"expr\": \"(count - loose_count) / count\"}, {\"name\": \"boxes_needed\", \"inputs\": [\"count\", \"box_capacity\"], \"output\": \"boxes_needed\", \"expr\": \"ceil(count / box_capacity)\"}]}", "tokens_in": 832, "tokens_out": 212}