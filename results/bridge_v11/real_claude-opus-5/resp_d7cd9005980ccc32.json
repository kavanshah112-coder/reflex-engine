 "text": "{\n \"lexicon_nouns\": [\n  {\n   \"kind\": \"count\",\n   \"noun\": \"days\"\n  }\n ],\n \"adj_maps\": [\n  {\n   \"adj\": \"receive\",\n   \"kind\": \"final_amount\"\n  },\n  {\n   \"adj\": \"hourly\",\n   \"kind\": \"rate\"\n  }\n ],\n \"unit_index\": [\n  {\n   \"unit\": \"hours\",\n   \"kind\": \"time\"\n  }\n ],\n \"conversions\": [],\n \"new_kinds\": [\n  {\n   \"name\": \"hourly_rate\",\n   \"dim\": [\n    0,\n    0,\n    -1,\n    0,\n    0,\n    0,\n    1\n   ],\n   \"unit\": \"$/h\",\n   \"nouns\": [\n    \"rate\"\n   ],\n   \"aliases\": [\n    \"hourly rate\"\n   ]\n  },\n  {\n   \"name\": \"days_count\",\n   \"dim\": [\n    0,\n    0,\n    0,\n    0,\n    0,\n    1,\n    0\n   ],\n   \"unit\": \"(count)\",\n   \"nouns\": [\n    \"days\"\n   ],\n   \"aliases\": [\n    \"days\"\n   ]\n  },\n  {\n   \"name\": \"weeks_count\",\n   \"dim\": [\n    0,\n    0,\n    0,\n    0,\n    0,\n    1,\n    0\n   ],\n   \"unit\": \"(count)\",\n   \"nouns\": [\n    \"weeks\"\n   ],\n   \"aliases\": [\n    \"week\",\n    \"weeks\"\n   ]\n  },\n  {\n   \"name\": \"attendance_bonus\",\n   \"dim\": [\n    0,\n    0,\n    0,\n    0,\n    0,\n    0,\n    1\n   ],\n   \"unit\": \"$\",\n   \"nouns\": [\n    \"attendance\"\n   ],\n   \"aliases\": [\n    \"$\"\n   ]\n  }\n ],\n \"new_caps\": [\n  {\n   \"name\": \"total_hours_worked\",\n   \"inputs\": [\n    \"time\",\n    \"days_count\",\n    \"weeks_count\"\n   ],\n   \"output\": \"time\",\n   \"expr\": \"time * days_count * weeks_count\"\n  },\n  {\n   \"name\": \"gross_pay\",\n   \"inputs\": [\n    \"hourly_rate\",\n    \"time\"\n   ],\n   \"output\": \"revenue\",\n   \"expr\": \"hourly_rate * time\"\n  },\n  {\n   \"name\": \"total_pay\",\n   \"inputs\": [\n    \"revenue\",\n    \"attendance_bonus\"\n   ],\n   \"output\": \"final_amount\",\n   \"expr\": \"revenue + attendance_bonus\"\n  }\n ]\n}",
