{"text": "{\"lexicon_nouns\": [{\"kind\": \"time\", \"noun\": \"hours\"}, {\"kind\": \"time\", \"noun\": \"minutes\"}], \"adj_maps\": [{\"adj\": \"earlier\", \"kind\": \"time\"}, {\"adj\": \"sleepwalking\", \"kind\": \"time\"}], \"unit_index\": [{\"unit\": \"p.m.\", \"kind\": \"clock_start\"}, {\"unit\": \"a.m.\", \"kind\": \"clock_end\"}, {\"unit\": \"am\", \"kind\": \"clock_end\"}], \"conversions\": [{\"concept\": \"time\", \"units\": [\"minutes\"], \"op\": \"mul\", \"factor\": 60}], \"new_kinds\": [{\"name\": \"clock_start\", \"dim\": [0, 0, 1, 0, 0, 0, 0], \"unit\": \"s\", \"nouns\": [\"sleep\"], \"aliases\": [\"p.m.\", \"pm\"]}, {\"name\": \"clock_end\", \"dim\": [0, 0, 1, 0, 0, 0, 0], \"unit\": \"s\", \"nouns\": [\"wakes\"], \"aliases\": [\"a.m.\", \"am\"]}], \"new_caps\": [{\"name\": \"time_in_bed\", \"inputs\": [\"clock_end\", \"clock_start\", \"time\"], \"output\": \"time\", \"expr\": \"(clock_end - clock_start) - time\"}]}", "tokens_in": 894, "tokens_out": 198}