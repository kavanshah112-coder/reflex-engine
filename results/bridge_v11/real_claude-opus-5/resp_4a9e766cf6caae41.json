{"text": "{\"lexicon_nouns\": [{\"kind\": \"mass\", \"noun\": \"pound\"}, {\"kind\": \"price_per_kg\", \"noun\": \"almonds\"}, {\"kind\": \"price_per_kg\", \"noun\": \"walnuts\"}], \"adj_maps\": [{\"adj\": \"costs\", \"kind\": \"price_per_kg\"}], \"unit_index\": [{\"unit\": \"pound\", \"kind\": \"mass\"}], \"conversions\": [{\"concept\": \"mass\", \"units\": [\"pound\"], \"op\": \"mul\", \"factor\": 0.45359237}, {\"concept\": \"price_per_kg\", \"units\": [\"$/pound\"], \"op\": \"div\", \"factor\": 0.45359237}], \"new_kinds\": [], \"new_caps\": [{\"name\": \"mixture_cost\", \"inputs\": [\"price_per_kg\", \"mass\"], \"output\": \"cost_total\", \"expr\": \"sum(price_per_kg * mass)\"}]}", "tokens_in": 861, "tokens_out": 146}