{"text": "{\"lexicon_nouns\": [{\"kind\": \"distance\", \"noun\": \"miles\"}, {\"kind\": \"count\", \"noun\": \"day\"}], \"adj_maps\": [{\"adj\": \"hike\", \"kind\": \"distance\"}, {\"adj\": \"covering\", \"kind\": \"distance\"}], \"unit_index\": [{\"unit\": \"miles\", \"kind\": \"distance\"}], \"conversions\": [{\"concept\": \"distance\", \"units\": [\"miles\"], \"op\": \"mul\", \"factor\": 1609.344}], \"new_kinds\": [{\"name\": \"daily_distance\", \"dim\": [0, 1, -1, 0, 0, 0, 0], \"unit\": \"m/day\", \"nouns\": [\"miles\"], \"aliases\": [\"miles per day\"]}], \"new_caps\": [{\"name\": \"extra_daily_distance\", \"inputs\": [\"distance\", \"count\", \"daily_distance\"], \"output\": \"daily_distance\", \"expr\": \"distance / count - daily_distance\"}]}", "tokens_in": 858, "tokens_out": 162}